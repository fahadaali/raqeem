{
  "name": "noor-erp",
  "version": "1.0.0",
  "private": true,
  "description": "منصة نور — منصة الإدارة المتكاملة (ERP) لمجمعات تحفيظ القرآن الكريم. بنية متعددة المستأجرين جاهزة للتحول إلى SaaS.",
  "type": "module",
  "main": "server/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "reset": "node server/db/reset.js",
    "gen:vapid": "node scripts/gen-vapid.js",
    "gen:icons": "node scripts/gen-icons.js",
    "backup": "node scripts/backup.js",
    "smoke": "node scripts/smoke-test.js",
    "setup": "npm run migrate && npm run seed && npm run gen:icons"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  }
}
