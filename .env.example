# ===== منصة نور | إعدادات التشغيل =====
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# مفتاح توقيع الجلسات (JWT) — غيّره في الإنتاج
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h
REFRESH_EXPIRES_DAYS=30

# قاعدة البيانات (SQLite افتراضياً)
DB_FILE=./data/noor.db

# التخزين السحابي — local | s3
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# عند استخدام S3:
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# إشعارات الويب (Web Push / VAPID)
# ولّدها بالأمر: npm run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# النسخ الاحتياطي اليومي الآلي
BACKUP_ENABLED=true
BACKUP_CRON_HOUR=2
BACKUP_KEEP=14

# الحد من الطلبات
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
PUBLIC_API_RATE_LIMIT_MAX=120

# نطاق تسجيل الحضور الجغرافي (متر)
GEOFENCE_DEFAULT_RADIUS=50
