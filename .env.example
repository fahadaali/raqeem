# ═══════════════════════════════════════════════════════════════════
#  منصة رقيم | إعدادات التشغيل الذاتي (Node)
#  على Cloudflare تُضبط القيم العلنية في [vars] داخل wrangler.toml
#  والسرّية عبر:  npx wrangler secret put <NAME>     — راجع docs/CLOUDFLARE.md
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# مفتاح توقيع الجلسات (JWT) — غيّره في الإنتاج
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h
REFRESH_EXPIRES_DAYS=30

# قاعدة البيانات (SQLite في التشغيل الذاتي · Cloudflare D1 في السحابة)
DB_FILE=./data/raqeem.db

# تخزين الملفات (القرص المحلي في التشغيل الذاتي · Cloudflare R2 في السحابة)
STORAGE_ROOT=./storage

# إشعارات الويب (Web Push / VAPID)
# ولّدها بالأمر: npm run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# النسخ الاحتياطي اليومي الآلي
BACKUP_ENABLED=true
BACKUP_CRON_HOUR=2
BACKUP_KEEP=14
BACKUP_DIR=./data/backups

# الحد من الطلبات
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
PUBLIC_API_RATE_LIMIT_MAX=120
LOGIN_IP_MAX=120
LOGIN_ACCOUNT_MAX=8

# نطاق تسجيل الحضور الجغرافي (متر)
GEOFENCE_DEFAULT_RADIUS=50

# أقصى حجم للمرفق (ميغابايت)
UPLOAD_MAX_MB=15
